# Local development only. Never commit .env.

APP_ENV=development
APP_HTTP_ADDR=:8080
APP_LOG_LEVEL=debug

DB_CONNECTION=pgx
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=change-me-local
